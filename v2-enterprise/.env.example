# Car Showroom Management System v2 — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit the real .env file to version control.

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
POSTGRES_DB=CarShowroomV2
POSTGRES_USER=showroom_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

ConnectionStrings__DefaultConnection=Host=db;Database=CarShowroomV2;Username=showroom_user;Password=CHANGE_ME_strong_db_password

# ─────────────────────────────────────────────
# JWT Authentication
# Generate a strong secret (minimum 64 characters / 512 bits):
#   Linux/macOS: openssl rand -base64 64
#   PowerShell:  [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Max 256 }))
# ─────────────────────────────────────────────
JwtSettings__Secret=CHANGE_ME_minimum_64_char_random_secret_replace_this_value_now

JwtSettings__Issuer=CarShowroomEnterprise
JwtSettings__Audience=CarShowroomEnterpriseUsers
JwtSettings__ExpiryMinutes=480

# ─────────────────────────────────────────────
# Admin Account Bootstrap
# Set InitialPassword only for first-run provisioning.
# Password must meet complexity: >= 8 chars, upper, lower, digit, special char.
# ─────────────────────────────────────────────
AdminSettings__InitialPassword=CHANGE_ME_Admin@Showroom2024!
AdminSettings__ForceResetPassword=false

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
Cors__AllowedOrigins__0=http://localhost:3000

# ─────────────────────────────────────────────
# Demo Data (development only — never enable in production)
# ─────────────────────────────────────────────
DEMO_SEED=false
