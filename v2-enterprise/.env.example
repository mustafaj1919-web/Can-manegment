# Car Showroom Management System v2 — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit the real .env file to version control.
#
# Variable naming: these are the SHORT names that docker-compose reads.
# docker-compose.yml maps them to ASP.NET hierarchical config internally
# (e.g.  JWT_SECRET  →  JwtSettings__Secret).

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
POSTGRES_DB=CarShowroomV2
POSTGRES_USER=showroom_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Full PostgreSQL connection string passed to the API container.
# Host must match the Postgres service name in docker-compose (v2-postgres-db).
CONNECTION_STRING=Host=v2-postgres-db;Database=CarShowroomV2;Username=showroom_user;Password=CHANGE_ME_strong_db_password

# ─────────────────────────────────────────────
# JWT Authentication
# Generate a strong secret (minimum 64 characters / 512 bits):
#   macOS/Linux: openssl rand -base64 64
#   PowerShell:  [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Max 256 }))
# ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_minimum_64_char_random_secret_replace_this_value_now
JWT_ISSUER=CarShowroomEnterprise
JWT_AUDIENCE=CarShowroomEnterpriseUsers

# ─────────────────────────────────────────────
# Admin Account Bootstrap
# Used once on first startup to create the admin user.
# Password must meet complexity: >= 8 chars, upper, lower, digit, special char.
# ─────────────────────────────────────────────
ADMIN_INITIAL_PASSWORD=CHANGE_ME_Admin@Showroom2024!
RESET_ADMIN_PASSWORD=false

# ─────────────────────────────────────────────
# Google Sign-In  (Flutter mobile app customer portal)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# The mobile app uses OAuth 2.0 client IDs per platform.
# Leave GOOGLE_ANDROID_CLIENT_ID empty if the Android app is not yet published.
# ─────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ─────────────────────────────────────────────
# Demo / Development  (set false in production)
# When DEMO_SEED=true, the API auto-seeds demo vehicles and customers on startup.
# ─────────────────────────────────────────────
DEMO_SEED=false
