# .env.example
# Car Showroom V2 Enterprise - Development Environment Template

# PostgreSQL Database Configuration
POSTGRES_DB=CarShowroomV2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# JWT Settings
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ISSUER=CarShowroomEnterprise
JWT_AUDIENCE=CarShowroomEnterpriseUsers

# ASP.NET Core API Configurations
ASPNETCORE_ENVIRONMENT=Development
CONNECTION_STRING=Host=v2-postgres-db;Database=CarShowroomV2;Username=postgres;Password=change_me_strong_password

# Next.js Frontend Configuration
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development
