# .env.production.example
# Car Showroom V2 Enterprise - Production Environment Template
# IMPORTANT: Copy this file to '.env' or '.env.production' and replace placeholders with secure, unique values.
# DO NOT commit the actual '.env' file containing real secrets to Git.

# 1. Database Configuration
# Generate a strong password (at least 32 characters, alphanumeric with special symbols)
POSTGRES_DB=CarShowroomV2_Prod
POSTGRES_USER=showroom_prod_admin
POSTGRES_PASSWORD=PLACEHOLDER_ENTER_A_STRONG_UNIQUE_PASSWORD_HERE

# 2. JWT (JSON Web Token) Configuration
# Generate a cryptographically secure key of at least 256 bits (32 bytes / characters)
# Example: openssl rand -base64 32
JWT_SECRET=PLACEHOLDER_ENTER_A_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_HERE
JWT_ISSUER=CarShowroomEnterpriseProd
JWT_AUDIENCE=CarShowroomEnterpriseProdUsers

# 3. ASP.NET Core API Settings
ASPNETCORE_ENVIRONMENT=Production
# Update DefaultConnection credentials to match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB defined above
CONNECTION_STRING=Host=v2-postgres-db;Database=CarShowroomV2_Prod;Username=showroom_prod_admin;Password=PLACEHOLDER_ENTER_A_STRONG_UNIQUE_PASSWORD_HERE

# 4. Next.js Frontend Settings
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
